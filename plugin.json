{
  "name": "dsh-session-index",
  "version": "2.5.1",
  "icon": "icon.svg",
  "displayName": {
    "zh": "全会话索引与跨会话记忆",
    "en": "Session Index & Cross-Session Memory"
  },
  "description": "完全化的 DSH 插件：在 DSH 插件页粘贴仓库地址即可安装（bundle 自动挂载，无需改配置、无需命令行），装完自动建索引、文件事件驱动识别新会话（无需重启），索引变更主动通知客户端，并自动生成可分发插件包与技能包。零第三方依赖，源会话只读。",
  "keywords": ["dsh", "dsh-bundle", "mcp", "session", "memory", "cross-session", "semantic-search", "auto-watch", "auto-package", "workbuddy", "one-click-install"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Lau-Jin/DSH.git",
    "install": "DSH 插件页粘贴 https://github.com/Lau-Jin/DSH 直接安装"
  },
  "distribution": {
    "bundle": {
      "declared": "package.json → dsh.bundle.patch = ./cordis.patch.yml",
      "patch": "cordis.patch.yml",
      "entries": [
        { "id": "session-index-host", "name": "dsh-session-index", "role": "宿主半身：解析自身安装路径" },
        { "id": "mcp-session-index", "name": "@deepseek-ai/dsh-mcp-client", "role": "MCP stdio 客户端：暴露工具/prompts/resources" }
      ],
      "selfResolving": "两处 !!js 表达式在 DSH 加载配置时求值，安装目录变化无需改文件"
    },
    "ways": [
      { "id": "plugin-page", "label": "DSH 插件页（推荐）", "steps": ["粘贴仓库地址", "安装", "重启 DSH"], "needsCli": false },
      { "id": "pnpm", "label": "pnpm 全局链接", "steps": ["pnpm add <路径或仓库>", "把 dsh-session-index 加入 profile 的 dsh.profile.bundles", "重启 DSH"] },
      { "id": "manual", "label": "手工安装（兼容旧方式）", "steps": ["node install.mjs", "重启 DSH"], "writesPatchBlock": true }
    ]
  },
  "mcp": {
    "transport": "stdio",
    "entry": "server.mjs",
    "resolvedBy": "cordis.patch.yml 的 !!js 表达式（按 环境变量 → 宿主记下的路径文件 → profile 标准安装位置 依次探测）",
    "capabilities": ["tools", "prompts", "resources", "instructions", "listChanged"],
    "toolCount": 14,
    "tools": [
      "session_index_status",
      "session_index_brief",
      "session_index_list",
      "session_index_related",
      "session_index_thread",
      "session_index_search",
      "session_index_get",
      "session_index_remember",
      "session_index_recall",
      "session_index_forget",
      "session_index_package",
      "session_index_vectors",
      "session_index_refresh",
      "session_index_stage"
    ],
    "prompts": ["session-context", "resume-topic", "catch-up", "quickstart"],
    "resources": [
      "session-index://guide",
      "session-index://plugin.json",
      "session-index://package",
      "session-index://brief",
      "session-index://memory",
      "session-index://status",
      "session-index://cards",
      "session-index://card/{id}"
    ]
  },
  "automatic": {
    "install": "node install.mjs（可选，插件页安装时可跳过）",
    "installWindows": "install.cmd（双击）",
    "verify": "node install.mjs --verify",
    "uninstall": "node install.mjs --uninstall",
    "update": "plugins 页重装，或 git pull && node install.mjs",
    "autoIndexOnStart": true,
    "autoRefresh": true,
    "refreshIntervalMs": 60000,
    "activeFileQuietMs": 45000,
    "watchNewSessions": true,
    "watchDebounceMs": 3500,
    "watchQuietMs": 6000,
    "onDemandFreshCheck": true,
    "notifyClientOnIndexChange": true,
    "skillAutoInstall": true,
    "envCustomPreservedOnReinstall": true,
    "autoPackage": ["plugin", "skill"]
  },
  "packages": {
    "directory": "dist",
    "plugin": "dsh-session-index-v2.5.1.zip",
    "skill": "session-index-skill-v2.5.1.zip",
    "generator": "lib/pack.mjs (zero dependency ZIP writer)",
    "contents": ["MANIFEST.json", "INSTALL.md"],
    "excludes": ["会话索引分片 *.jsonl.gz", "meta/cards/notes/vectors.json", "备份与临时文件", "已有 zip"]
  },
  "requirements": {
    "node": ">=22.15",
    "os": ["win32", "darwin", "linux"],
    "sourceDirs": ["~/.dsh/sessions", "~/.workbuddy/projects"]
  },
  "safety": {
    "sourceSessions": "read-only",
    "writesOnlyTo": "~/.dsh/session-index/ 与 dist/",
    "configBackup": "install.mjs 写 cordis.patch.yml 前自动备份",
    "rollback": "node install.mjs --uninstall，或插件页禁用/卸载",
    "privateData": "索引、长期记忆、备份一律不入库；分发包已自动排除"
  }
}
