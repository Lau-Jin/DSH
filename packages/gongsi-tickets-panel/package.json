{
  "name": "@local/gongsi-tickets-panel",
  "version": "1.0.9",
  "description": "gongsi (公司工单) panel for DeepSeek Harness: browse, filter, page, and act on the tickets of the gongsi MCP server from the left sidebar.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "gongsi",
    "tickets",
    "mcp"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "test": "node test/panel-layout.test.mjs && node test/assign-picker.test.mjs && node test/complete-root-cause.test.mjs && node test/root-cause.test.mjs",
    "test:install": "node test/install-matrix.test.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills/**",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/schemastery": "3.18.5",
    "@standard-schema/spec": "1.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
