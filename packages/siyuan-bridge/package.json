{
  "name": "dsh-siyuan-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "思源桥面板：把 SiYuan 的搜索 / 阅读 / 编辑 / 导出界面嵌进 DeepSeek Harness 的主面板。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "license": "MIT"
}
